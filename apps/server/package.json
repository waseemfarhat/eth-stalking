{
  "name": "@eth-stalking/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:export": "tsx scripts/export.ts",
    "db:import": "tsx scripts/import.ts",
    "db:rotate-passwords": "tsx scripts/rotate-passwords.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "prisma": "6.19.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
