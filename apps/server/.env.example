# ─────────────────────────────────────────────────────────────────────────────
# ETH STALKING — server configuration. Copy to apps/server/.env
# NEVER put wallet private keys, seed phrases or recovery phrases anywhere in this project.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Origin of the web app (used for CORS and Origin/CSRF checks)
APP_ORIGIN=http://localhost:5173

# SQLite file, path is relative to apps/server/prisma/schema.prisma -> <repo>/data/app.db
DATABASE_URL="file:../../../data/app.db"

# Session lifetime
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60

# ── Blockchain ───────────────────────────────────────────────────────────────
# CHAIN_MODE:
#   sample  – no network access; clearly labelled SAMPLE transfers created from the admin console
#   sepolia – Ethereum Sepolia testnet with a test ERC-20 (there is no official USDT on Sepolia)
#   mainnet – Ethereum mainnet, official USDT. Real deposits still require the compliance gate below.
CHAIN_MODE=sample

# JSON-RPC endpoint for sepolia/mainnet (e.g. a free public endpoint or your own provider key).
# Keep provider keys here only — never in frontend code.
ETH_RPC_URL=

# Expected chain id (1 = mainnet, 11155111 = sepolia). Verified against the RPC on every check.
CHAIN_ID=31337

# Token contract to accept. Mainnet official USDT (Tether): 0xdAC17F958D2ee523a2206206994597C13D831ec7
# For sepolia, set your test ERC-20 address here.
TOKEN_CONTRACT=
TOKEN_DECIMALS=6
TOKEN_SYMBOL=USDT

# Confirmations required before a deposit (or payout) counts as confirmed.
# Admins can raise this at runtime but never lower it below this floor.
MIN_CONFIRMATIONS=12

# Background jobs
CHAIN_POLL_INTERVAL_MS=30000
# Scan the receiving address for transfers nobody has claimed (unmatched deposits)
SCANNER_ENABLED=true
SCANNER_BLOCK_CHUNK=500
# Give up on a submitted hash that never appears on-chain after this many hours
DEPOSIT_NOT_FOUND_EXPIRY_HOURS=24

# ── Real network check (admin tool, READ-ONLY) ────────────────────────────────
# Looks up real mainnet USDT balances/transfers for configured wallets so you can confirm
# that real transfers are detected and verified. It never credits any account.
# Default is a free public endpoint; replace with your own provider URL if you prefer.
MAINNET_CHECK_RPC_URL=https://ethereum-rpc.publicnode.com

# ── Legal & compliance gate ──────────────────────────────────────────────────
# Real customer deposits stay disabled unless ALL of the following are true:
#   1. REAL_DEPOSITS_ENABLED=true
#   2. CHAIN_MODE=mainnet and CHAIN_ID=1
#   3. COMPLIANCE_ATTESTATION_PATH points to a complete, unexpired attestation (see docs/COMPLIANCE.md)
#   4. The active receiving wallet's ownership has been proven by signed message
# There is intentionally no UI switch for this.
REAL_DEPOSITS_ENABLED=false
COMPLIANCE_ATTESTATION_PATH=../../compliance/attestation.json
